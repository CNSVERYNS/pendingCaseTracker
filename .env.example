# Copy to .env and fill in your Supabase project's values (Project Settings > API).
# These are safe to expose to the client — the anon key only works within RLS policies.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/seed.ts (a Node script, never bundled into the app).
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely — never prefix it
# EXPO_PUBLIC_, which would ship it inside the client bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
