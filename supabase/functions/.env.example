# Copy to supabase/functions/.env for local `supabase functions serve --env-file`,
# or `supabase secrets set --env-file supabase/functions/.env` to deploy.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by
# the Supabase platform at runtime — do not set them here for a deployed
# project; only needed for local emulation.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# developer.uscis.gov sandbox — confirmed against the official Case Status
# API v1.0 OpenAPI spec (see src/lib/uscis.ts module doc for what's verified
# vs. still assumed). You still need your own client_id/client_secret from a
# developer.uscis.gov account with Case Status API sandbox access.
USCIS_BASE_URL=https://api-int.uscis.gov
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
